@page
@model RP123.Pages.PTApp.Items.CreateModel

<h1>Create Item</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Item.Sku"></label>
        <input asp-for="Item.Sku" class="form-control" />
        <span asp-validation-for="Item.Sku" class="text-danger" />
    </div>
    <div class="form-group">
        <label asp-for="Item.Description"></label>
        <input asp-for="Item.Description" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Item.Price"></label>
        <input asp-for="Item.Price" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</form>
